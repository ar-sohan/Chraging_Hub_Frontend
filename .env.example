# Copy to .env.local for local development, or set these in Vercel's
# Project Settings > Environment Variables for production.

# URL of the NestJS backend (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Pusher public key + cluster (optional, for realtime notifications)
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap2
